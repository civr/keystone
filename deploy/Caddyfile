{
	# TLS terminates at the operator's reverse proxy.
	auto_https off
	servers {
		# keystone-core decides which forwarded headers to trust.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:80 {
	encode zstd gzip
	root * /srv

	# Everything SvelteKit emits under /_app comes from this image's build
	# (hashed chunks plus version.json); it is never proxied to core.
	@immutable path /_app/immutable/*
	handle @immutable {
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle /_app/* {
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	@static path /favicon.svg /favicon.png /favicon.ico /robots.txt
	handle @static {
		file_server
	}

	handle {
		reverse_proxy core:8080
	}
}
